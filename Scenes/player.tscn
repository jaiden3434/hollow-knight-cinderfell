[sub_resource type="GDScript" id="GDScript_fkybt"]
script/source = "extends CharacterBody2D


const SPEED = 300.0
const JUMP_VELOCITY = -400.0

var has_landed : bool = false
@onready var camera_2d: Camera2D = $Camera2D

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
		
	if velocity.y > 0.0:
		velocity.y = lerp(velocity.y, velocity.y * Globals.fallMultiplier, 1.5)
		# If we are falling, fall faster than normal
		
		
	# Horizontal movement
	var axis = Input.get_axis(\"left\", \"right\")
	
	if Globals.canMove:
		if axis:
			Globals.playerDirection = axis
			velocity.x = Globals.playerSpeed	 * axis
		else:
			velocity.x = 0.0
			Globals.playerDirection = 0
	
		
	# Camera smoothening
	if velocity.y < 0.0:
		camera_2d.offset.y = lerp(camera_2d.offset.y, -1000.0, 0.03)
	elif velocity.y >= 0.0:
		camera_2d.offset.y = lerp(camera_2d.offset.y, -1000.0, 0.03) 
	
	if Globals.playerDirection == -1:
		camera_2d.offset.x = lerp(camera_2d.offset.x, -1500.0, 0.03)
	elif Globals.playerDirection == 1:
		camera_2d.offset.x = lerp(camera_2d.offset.x, 1500.0, 0.03) 
	elif Globals.playerDirection == 0:
		camera_2d.offset.x = lerp(camera_2d.offset.x, 0.0, 0.03) 
	
		
		

	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	move_and_slide()
"

